# Copy this file to .env and fill in the empty values. Never commit .env.
# Variables are validated in src/env.js: the app won't start if a required one is missing.

# NextAuth secret; generate one with `npx auth secret` (required in production only).
AUTH_SECRET=""

# Client ID of the Discord OAuth app used for sign-in (https://discord.com/developers/applications).
AUTH_DISCORD_ID=""
# Client secret of the same Discord OAuth app.
AUTH_DISCORD_SECRET=""

# Postgres URL; ./start-database.sh reads it and offers to replace the default password.
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai-app-template"

# Redis URL; ./start-redis.sh reads it and offers to replace the default password.
REDIS_URL="redis://default:redis-pw@localhost:6379"

# Google AI Studio API key for the Gemini models (https://aistudio.google.com/apikey).
GOOGLE_GENERATIVE_AI_API_KEY=""

# Serper API key for web search results (https://serper.dev).
SERPER_API_KEY=""

# Langfuse secret key for sending traces (https://langfuse.com).
LANGFUSE_SECRET_KEY=""
# Langfuse public key.
LANGFUSE_PUBLIC_KEY=""
# Langfuse host, e.g. https://cloud.langfuse.com.
LANGFUSE_BASEURL=""
